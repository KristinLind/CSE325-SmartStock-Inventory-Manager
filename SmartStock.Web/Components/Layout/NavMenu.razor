@inject AuthService Auth
@inject NavigationManager Nav

@implements IDisposable
@inject CartService CartSvc

<div class="nav-item px-3">
    <NavLink class="nav-link" href="cart">
        Cart <span class="badge bg-secondary">@CartSvc.ItemCount</span>
    </NavLink>
</div>

@code {
    protected override void OnInitialized()
    {
        CartSvc.OnChange += Refresh;
        Auth.OnAuthStateChanged += HandleAuthStateChanged;
    }

    private void Refresh() => InvokeAsync(StateHasChanged);
}

<div class="smartstock-navigation">

    <NavLink class="smartstock-brand" href="" Match="NavLinkMatch.All">
        SmartStock
    </NavLink>

    <nav class="smartstock-links" aria-label="Main navigation">

        <NavLink href="" Match="NavLinkMatch.All">
            Dashboard
        </NavLink>

        <NavLink href="inventory">
            Inventory
        </NavLink>

        <NavLink href="products">
            Products
        </NavLink>

        <NavLink href="categories">
            Categories
        </NavLink>

        <NavLink href="sales">
            Record Sale
        </NavLink>

        @if (Auth.IsAuthenticated && Auth.CurrentUser is not null)
        {
            <span class="smartstock-user-badge" title="@Auth.CurrentUser.Email">
                @Auth.CurrentUser.FullName
            </span>
            <button type="button" class="smartstock-logout-button" @onclick="HandleLogoutAsync">
                Sign Out
            </button>
        }
        else
        {
            <NavLink href="login" class="smartstock-login-link">
                Sign In
            </NavLink>
        }

    </nav>

</div>

@code {
    private void HandleAuthStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task HandleLogoutAsync()
    {
        await Auth.LogoutAsync();
        Nav.NavigateTo("/login");
    }

    public void Dispose()
    {
        CartSvc.OnChange -= Refresh;
        Auth.OnAuthStateChanged -= HandleAuthStateChanged;
    }
}

