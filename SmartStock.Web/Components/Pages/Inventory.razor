@page "/inventory"
@rendermode InteractiveServer
@implements IDisposable
@inject AuthService Auth
@inject ProductService ProductSvc
@inject CategoryService CategorySvc
@inject NavigationManager Nav

<PageTitle>SmartStock | Inventory Management</PageTitle>

<div class="inventory-manager">
    <div class="inventory-header">
        <div>
            <p class="inventory-eyebrow">SMARTSTOCK INVENTORY MANAGER</p>
            <h1>Inventory Management</h1>
            <p>Add, update, and organize your kitchen products.</p>
        </div>

        @if (Auth.IsAuthenticated)
        {
            <button class="inventory-add-button"
                    @onclick="ShowAddForm">
                + Add Product
            </button>
        }
        else
        {
            <a class="inventory-add-button inventory-signin-cta"
               href="/login?returnUrl=/inventory">
                Sign In to Manage Inventory
            </a>
        }
    </div>

    @if (!Auth.IsAuthenticated)
    {
        <div class="inventory-readonly-banner" role="status">
            <span><strong>Read-Only View:</strong> You can browse, search, filter, and view product details. Sign in to add, edit, or delete products.</span>
            <a href="/login?returnUrl=/inventory">Sign In →</a>
        </div>
    }

    <div class="inventory-summary">
        <div class="inventory-summary-card">
            <span>Total Products</span>
            <strong>@products.Count</strong>
        </div>
        <div class="inventory-summary-card">
            <span>Low Stock Items</span>
            <strong>@products.Count(p => p.Quantity < 5)</strong>
        </div>
        <div class="inventory-summary-card">
            <span>Inventory Value</span>
            <strong>@products.Sum(p => p.Price * p.Quantity).ToString("C")</strong>
        </div>
    </div>
    @if (selectedProduct != null)
    {
        <section class="inventory-form-card">
            <h2>Product Details</h2>

            <div style="display: flex; gap: 30px; align-items: center; flex-wrap: wrap;">

                @if (!string.IsNullOrWhiteSpace(selectedProduct.Image))
                {
                    <img src="@selectedProduct.Image"
                        alt="@selectedProduct.Name"
                        style="width: 220px; height: 220px; object-fit: contain; border-radius: 12px;" />
                }

                <div>
                    <h3>@selectedProduct.Name</h3>

                    <p><strong>SKU:</strong> @selectedProduct.Sku</p>
                    <p><strong>Category:</strong> @selectedProduct.Category</p>
                    <p><strong>Unit Price:</strong> @selectedProduct.Price.ToString("C")</p>
                    <p><strong>Quantity Available:</strong> @selectedProduct.Quantity</p>

                    <p>
                        <strong>Stock Status:</strong>
                        @if (selectedProduct.Quantity == 0)
                        {
                            <span class="stock-badge out-of-stock">Out of Stock</span>
                        }
                        else if (selectedProduct.Quantity < 5)
                        {
                            <span class="stock-badge low-stock">Low Stock</span>
                        }
                        else
                        {
                            <span class="stock-badge in-stock">In Stock</span>
                        }
                    </p>
                </div>
            </div>

        <div class="inventory-form-actions">
            <button class="inventory-cancel-button"
                    @onclick="CloseProductDetails">
                Close Details
            </button>
        </div>
    </section>
}

    @if (showForm)
    {
        <section class="inventory-form-card">
            <h2>@(editingId == null ? "Add New Product" : "Edit Product")</h2>

            <div class="inventory-form-grid">
                <div>
                    <label for="product-name">Product Name</label>
                    <input id="product-name" @bind="formName" />
                </div>

                <div>
                    <label for="product-sku">SKU</label>
                    <input id="product-sku" @bind="formSku" placeholder="e.g. APP-013" />
                </div>

                <div>
                    <label for="product-image">Product Image</label>
                    <select id="product-image" @bind="formImage">
                        <option value="">No image</option>
                        @foreach (var image in imageOptions)
                        {
                            <option value="@image.Path">@image.Label</option>
                        }
                    </select>
                </div>

                <div>
                    <label for="product-category">Category</label>
                    <select id="product-category" @bind="formCategoryId">
                        @foreach (var category in dbCategories)
                        {
                            <option value="@category.Id">@category.Name</option>
                        }
                    </select>
                </div>

                <div>
                    <label for="product-price">Unit Price ($)</label>
                    <input id="product-price"
                           type="number"
                           min="0"
                           step="0.01"
                           @bind="formPrice" />
                </div>

                <div>
                    <label for="product-quantity">Quantity</label>
                    <input id="product-quantity"
                           type="number"
                           min="0"
                           @bind="formQuantity" />
                </div>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <p class="inventory-error" role="alert">@errorMessage</p>
            }

            <div class="inventory-form-actions">
                <button class="inventory-save-button"
                        @onclick="SaveProduct">
                    @(editingId == null ? "Save Product" : "Update Product")
                </button>

                <button class="inventory-cancel-button"
                        @onclick="CancelForm">
                    Cancel
                </button>
            </div>
        </section>
    }
    @if (productToDeleteId != null)
{
    <div class="inventory-form-card" role="alertdialog"
         aria-label="Confirm product deletion">
        <h2>Delete Product?</h2>
        <p>Are you sure you want to delete this product?</p>

        <div class="inventory-form-actions">
            <button class="delete-button"
                    @onclick="DeleteConfirmed">
                Yes, Delete
            </button>

            <button class="inventory-cancel-button"
                    @onclick="CancelDelete">
                Cancel
            </button>
        </div>
    </div>
}
    <section class="inventory-table-card">
        <div class="inventory-filters">
            <div>
                <label for="inventory-search">Search products or SKU</label>
                <input id="inventory-search" placeholder="Search inventory..." @bind="searchText" @bind:event="oninput" />
            </div>
            <div>
                <label for="inventory-category">Filter by category</label>
                <select id="inventory-category" @bind="selectedCategory">
                    <option value="All">All Categories</option>
                    <option value="Small Kitchen Appliances">Small Kitchen Appliances</option>
                    <option value="Cookware and Utensils">Cookware and Utensils</option>
                    <option value="Food Storage and Organization">Food Storage and Organization</option>
                    <option value="Home Essentials and Accessories">Home Essentials and Accessories</option>
                </select>
            </div>
        </div>
        <div class="inventory-table-heading">
            <h2>Product Inventory</h2>
            <span>@FilteredProducts.Count of @products.Count products</span>
        </div>

        <div class="inventory-table-scroll">
            <table class="inventory-table">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>SKU</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Quantity</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var product in FilteredProducts)
                    {
                        <tr>
                            <td>
                                <div class="inventory-product-cell">
                                    @if (!string.IsNullOrWhiteSpace(product.Image))
                                    {
                                        <img src="@product.Image" alt="@product.Name" class="inventory-product-image" />
                                    }
                                    <strong>@product.Name</strong>
                                </div>
                            </td>
                            <td>@product.Sku</td>
                            <td>@product.Category</td>
                            <td>@product.Price.ToString("C")</td>
                            <td>@product.Quantity</td>
                            <td>
                                @if (product.Quantity == 0)
                                {
                                    <span class="stock-badge out-of-stock">Out of Stock</span>
                                }
                                else if (product.Quantity < 5)
                                {
                                    <span class="stock-badge low-stock">Low Stock</span>
                                }
                                else
                                {
                                    <span class="stock-badge in-stock">In Stock</span>
                                }
                            </td>
                            <td>
                                <div class="inventory-row-actions">
                                    <button class="edit-button"
                                            @onclick="() => ViewProduct(product)">
                                        View Details
                                    </button>

                                    @if (Auth.IsAuthenticated)
                                    {
                                        <button class="edit-button"
                                                @onclick="() => EditProduct(product)">
                                            Edit
                                        </button>

                                        <button class="delete-button"
                                                @onclick="() => ConfirmDelete(product.Id)">
                                            Delete
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (FilteredProducts.Count == 0)
        {
            <p class="inventory-empty">No matching products. Try a different search or category, or add a new product.</p>
        }
    </section>
</div>

@code {
    private List<InventoryProduct> products = new();
    private List<Category> dbCategories = new();

    private readonly (string Path, string Label)[] imageOptions = new[]
    {
        ("/images/hand-blenders.webp", "Hand Blender"),
        ("/images/blender.webp", "Countertop Blender"),
        ("/images/copper-pot.webp", "Copper Stock Pot"),
        ("/images/instant-pot.webp", "Instant Pot"),
        ("/images/stand-mixer.webp", "Stand Mixer"),
        ("/images/cast-iron-pan.webp", "Cast Iron Pan"),
        ("/images/rice-cooker.webp", "Rice Cooker"),
        ("/images/pastry-cutter.webp", "Pastry Cutter"),
        ("/images/vegetable-peelers.webp", "Vegetable Peelers"),
        ("/images/wooden-spoon.webp", "Wooden Spoon"),
        ("/images/whisks.webp", "Whisks"),
        ("/images/silverware.webp", "Silverware Set"),
        ("/images/submersion-blendor.webp", "Immersion Blender"),
        ("/images/sponges.webp", "Sponges"),
        ("/images/utinsel-holder.webp", "Utensil Holder"),
        ("/images/glass-storage.webp", "Glass Food Storage Containers"),
        ("/images/storage-jars.webp", "Kitchen Storage Jars"),
        ("/images/white-containers.webp", "White Storage Containers")
    };

    [SupplyParameterFromQuery(Name = "category")]
    public string? CategoryFromUrl { get; set; }

    private string searchText = "";
    private string selectedCategory = "All";

    protected override async Task OnInitializedAsync()
    {
        Auth.OnAuthStateChanged += HandleAuthStateChanged;
        await LoadFromDatabaseAsync();
    }

    private async Task LoadFromDatabaseAsync()
    {
        dbCategories = await CategorySvc.GetAllAsync();
        var dbProducts = await ProductSvc.GetAllAsync();
        products = dbProducts.Select(p => new InventoryProduct
        {
            Id = p.Id,
            Name = p.Name,
            Sku = p.Sku,
            Image = p.ImageUrl,
            CategoryId = p.CategoryId,
            Category = p.Category?.Name ?? "Small Kitchen Appliances",
            Price = p.Price,
            Quantity = p.Quantity
        }).ToList();
    }

    private void HandleAuthStateChanged()
    {
        if (!Auth.IsAuthenticated)
        {
            showForm = false;
            editingId = null;
            productToDeleteId = null;
        }
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Auth.OnAuthStateChanged -= HandleAuthStateChanged;
    }

    protected override void OnParametersSet()
    {
        string[] validCategories =
        {
            "Small Kitchen Appliances",
            "Cookware and Utensils",
            "Food Storage and Organization",
            "Home Essentials and Accessories"
        };

        var category = CategoryFromUrl?.Trim();

        selectedCategory = validCategories.Contains(category)
            ? category!
            : "All";
    }
    private List<InventoryProduct> FilteredProducts => products
        .Where(p => (selectedCategory == "All" || p.Category == selectedCategory)
            && (string.IsNullOrWhiteSpace(searchText)
                || p.Name.Contains(searchText, StringComparison.OrdinalIgnoreCase)
                || p.Sku.Contains(searchText, StringComparison.OrdinalIgnoreCase)))
        .ToList();

    private bool showForm;
    private int? editingId;
    private string formName = "";
    private string formSku = "";
    private string formImage = "";
    private int formCategoryId;
    private decimal formPrice;
    private int formQuantity;
    private string errorMessage = "";

    private void ShowAddForm()
    {
        if (!Auth.IsAuthenticated)
        {
            Nav.NavigateTo("/login?returnUrl=/inventory");
            return;
        }

        editingId = null;
        formName = "";
        formSku = "";
        formImage = "";
        formCategoryId = dbCategories.FirstOrDefault()?.Id ?? 0;
        formPrice = 0;
        formQuantity = 0;
        errorMessage = "";
        showForm = true;
    }

    private InventoryProduct? selectedProduct;

    private void ViewProduct(InventoryProduct product)
    {
        selectedProduct = product;
    }

    private void CloseProductDetails()
    {
        selectedProduct = null;
    }

    private void EditProduct(InventoryProduct product)
    {
        if (!Auth.IsAuthenticated)
        {
            Nav.NavigateTo("/login?returnUrl=/inventory");
            return;
        }

        editingId = product.Id;
        formName = product.Name;
        formSku = product.Sku;
        formImage = product.Image;
        formCategoryId = product.CategoryId;
        formPrice = product.Price;
        formQuantity = product.Quantity;
        errorMessage = "";
        showForm = true;
    }

    private async Task SaveProduct()
    {
        if (!Auth.IsAuthenticated)
        {
            Nav.NavigateTo("/login?returnUrl=/inventory");
            return;
        }

        if (string.IsNullOrWhiteSpace(formName))
        {
            errorMessage = "Please enter a product name.";
            return;
        }

        if (string.IsNullOrWhiteSpace(formSku))
        {
            errorMessage = "Please enter a SKU.";
            return;
        }

        if (products.Any(p => p.Sku.Equals(formSku.Trim(), StringComparison.OrdinalIgnoreCase)
            && p.Id != editingId))
        {
            errorMessage = "This SKU is already assigned to another product.";
            return;
        }

        if (formPrice <= 0 || formQuantity < 0)
        {
            errorMessage = "Price must be greater than 0 and quantity cannot be negative.";
            return;
        }

        try
        {
            if (!dbCategories.Any(c => c.Id == formCategoryId))
            {
                errorMessage = "Please select a valid category.";
                return;
            }

            Product entity;
            if (editingId == null)
            {
                entity = new Product();
            }
            else
            {
                entity = await ProductSvc.GetByIdAsync(editingId.Value) ?? new Product { Id = editingId.Value };
            }

            entity.Name = formName.Trim();
            entity.Sku = formSku.Trim();
            entity.ImageUrl = formImage;
            entity.CategoryId = formCategoryId;
            entity.Price = formPrice;
            entity.Quantity = formQuantity;

            await ProductSvc.SaveAsync(entity);
            await LoadFromDatabaseAsync();
            CancelForm();
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
        }
        catch
        {
            errorMessage = "Unable to save the product. Please try again.";
        }
    }

    private async Task DeleteProductAsync(int id)
    {
        try
        {
            await ProductSvc.DeleteAsync(id);
            await LoadFromDatabaseAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }

        if (editingId == id)
        {
            CancelForm();
        }
    }

    private void CancelForm()
    {
        showForm = false;
        editingId = null;
        errorMessage = "";
    }

    private class InventoryProduct
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string Sku { get; set; } = "";
        public string Image { get; set; } = "";
        public int CategoryId { get; set; }
        public string Category { get; set; } = "";
        public decimal Price { get; set; }
        public int Quantity { get; set; }
    }

    private int? productToDeleteId;

    private void ConfirmDelete(int id)
    {
        if (!Auth.IsAuthenticated)
        {
            Nav.NavigateTo("/login?returnUrl=/inventory");
            return;
        }
        productToDeleteId = id;
    }

    private async Task DeleteConfirmed()
    {
        if (!Auth.IsAuthenticated)
        {
            productToDeleteId = null;
            Nav.NavigateTo("/login?returnUrl=/inventory");
            return;
        }

        if (productToDeleteId.HasValue)
        {
            await DeleteProductAsync(productToDeleteId.Value);
        }

        productToDeleteId = null;
    }

    private void CancelDelete()
    {
        productToDeleteId = null;
    }
}

<style>
    .inventory-readonly-banner {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        background: #fff8e6;
        border: 1px solid #f59e0b;
        color: #78350f;
        padding: 14px 20px;
        border-radius: 12px;
        margin-bottom: 24px;
        font-size: 0.95rem;
    }

    .inventory-readonly-banner a {
        color: #b45309;
        font-weight: 700;
        text-decoration: none;
        white-space: nowrap;
    }

    .inventory-readonly-banner a:hover {
        text-decoration: underline;
    }

    .inventory-signin-cta {
        text-decoration: none;
        display: inline-block;
    }
    .inventory-manager {
        max-width: 1400px;
        margin: 0 auto;
        padding: 45px 5%;
        color: #172a46;
    }

    .inventory-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 30px;
    }

    .inventory-eyebrow {
        color: #f44336;
        font-weight: 700;
        font-size: 0.8rem;
        letter-spacing: 1.5px;
    }

    .inventory-header h1 {
        font-family: Georgia, serif;
        font-size: clamp(2rem, 4vw, 2.8rem);
        margin: 8px 0;
    }

    .inventory-header p {
        color: #64748b;
    }

    .inventory-add-button,
    .inventory-save-button {
        background: #172a46;
        color: white;
        border: none;
        border-radius: 9px;
        padding: 13px 20px;
        font-weight: 700;
        cursor: pointer;
    }

    .inventory-add-button:hover,
    .inventory-save-button:hover {
        background: #f44336;
    }

    .inventory-summary {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin-bottom: 30px;
    }

    .inventory-summary-card {
        background: white;
        border-radius: 14px;
        padding: 24px;
        border: 1px solid #e5e7eb;
        box-shadow: 0 6px 18px rgba(23, 42, 70, 0.07);
    }

    .inventory-summary-card span {
        display: block;
        color: #64748b;
        margin-bottom: 10px;
    }

    .inventory-summary-card strong {
        font-size: 2rem;
        color: #172a46;
    }

    .inventory-form-card,
    .inventory-table-card {
        background: white;
        padding: 28px;
        border-radius: 16px;
        margin-bottom: 30px;
        box-shadow: 0 8px 25px rgba(23, 42, 70, 0.08);
    }

    .inventory-form-card h2,
    .inventory-table-heading h2 {
        font-family: Georgia, serif;
        margin: 0 0 20px;
    }

    .inventory-form-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
    }

    .inventory-form-grid label {
        display: block;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .inventory-form-grid input,
    .inventory-form-grid select {
        width: 100%;
        padding: 12px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        box-sizing: border-box;
    }

    .inventory-form-actions {
        display: flex;
        gap: 12px;
        margin-top: 24px;
    }

    .inventory-cancel-button {
        background: #e5e7eb;
        color: #172a46;
        border: none;
        border-radius: 9px;
        padding: 13px 20px;
        cursor: pointer;
    }

    .inventory-error {
        color: #b91c1c;
        margin-top: 15px;
    }

    .inventory-table-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
    }

    .inventory-filters {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 18px;
        margin-bottom: 24px;
    }

    .inventory-filters label {
        display: block;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .inventory-filters input,
    .inventory-filters select {
        width: 100%;
        padding: 12px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        box-sizing: border-box;
    }

    .inventory-product-cell {
        display: flex;
        align-items: center;
        gap: 14px;
        min-width: 185px;
    }

    .inventory-product-image {
        width: 60px;
        height: 60px;
        object-fit: cover;
        border-radius: 9px;
        background: #f7f5ef;
        flex-shrink: 0;
    }

    .inventory-table-scroll {
        overflow-x: auto;
    }

    .inventory-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 650px;
    }

    .inventory-table th,
    .inventory-table td {
        text-align: left;
        padding: 16px 12px;
        border-bottom: 1px solid #e5e7eb;
    }

    .inventory-table th {
        color: #64748b;
        font-size: 0.85rem;
    }

    .inventory-row-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    min-width: 180px;
    }

    .inventory-row-actions button {
    white-space: nowrap;
    font-size: 0.85rem;
    padding: 8px 10px;
    }

    .edit-button,
    .delete-button {
        padding: 8px 12px;
        border: none;
        border-radius: 7px;
        cursor: pointer;
    }

    .edit-button {
        background: #fff0cc;
        color: #775016;
    }

    .delete-button {
        background: #fee2e2;
        color: #b91c1c;
    }

    .stock-badge {
        display: inline-block;
        padding: 6px 10px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .in-stock {
        background: #dcfce7;
        color: #166534;
    }

    .low-stock {
        background: #fff0cc;
        color: #92400e;
    }

    .out-of-stock {
        background: #fee2e2;
        color: #b91c1c;
    }

    .inventory-empty {
        padding: 25px;
        text-align: center;
        color: #64748b;
    }

    @@media (max-width: 700px) {
        .inventory-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .inventory-summary {
            grid-template-columns: 1fr;
        }

        .inventory-form-grid,
        .inventory-filters {
            grid-template-columns: 1fr;
        }
    }
</style>