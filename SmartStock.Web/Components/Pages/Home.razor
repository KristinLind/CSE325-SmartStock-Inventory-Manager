@page "/"

<PageTitle>SmartStock | Dashboard</PageTitle>

<div class="smartstock-dashboard">

    <section class="smartstock-hero">
        <div class="hero-content">
            <span class="hero-eyebrow">WELCOME TO SMARTSTOCK</span>

            <h2>Everything for your kitchen, organized.</h2>

            <p>
                Track products, manage inventory, and keep your
                kitchen retail business running smoothly.
            </p>

            <span class="hero-tagline">
                Smart Inventory. Better Business.
            </span>
        </div>
    </section>


    <section class="dashboard-welcome">
        <div>
            <p class="dashboard-eyebrow">SMARTSTOCK INVENTORY MANAGER</p>
            <h1>Kitchen Inventory Dashboard</h1>
            <p>Organized inventory. Smarter business.</p>
        </div>
        <span class="dashboard-preview-label">Design Preview</span>
    </section>

    <section class="dashboard-stats">
        <div class="stat-card">
            <h2>Total Products</h2>
            <p class="stat-number">128</p>
            <div class="stat-accent navy-accent"></div>
        </div>

        <div class="stat-card">
            <h2>Low Stock Items</h2>
            <p class="stat-number tomato-text">8</p>
            <div class="stat-accent tomato-accent"></div>
        </div>

        <div class="stat-card">
            <h2>Inventory Value</h2>
            <p class="stat-number">$24,850</p>
            <div class="stat-accent saffron-accent"></div>
        </div>
    </section>

    

<section class="inventory-section">
    <div class="section-heading">
        <h2>Inventory Categories</h2>
        <span>Browse by Category</span>
    </div>

    <div class="product-grid">

        <!-- Cookware -->
        <article class="product-card">
            <div class="product-placeholder">
                <img src="/images/copper-pot.webp"
                     alt="Copper stock pot"
                     class="product-image" />
            </div>
            <div class="product-details">
                <h3>Cookware</h3>
                <p>Pots, pans, and cooking essentials</p>
                <a href="/inventory">View Inventory</a>
            </div>
        </article>

        <!-- Appliances -->
        <article class="product-card">
            <div class="product-placeholder">
                <img src="/images/stand-mixer.webp"
                     alt="Stand mixer"
                     class="product-image" />
            </div>
            <div class="product-details">
                <h3>Appliances</h3>
                <p>Blenders, mixers, and kitchen appliances</p>
                <a href="/inventory">View Inventory</a>
            </div>
        </article>

        <!-- Kitchen Utensils -->
        <article class="product-card">
            <div class="product-placeholder">
                <img src="/images/wooden-spoon.webp"
                     alt="Wooden kitchen spoon"
                     class="product-image" />
            </div>
            <div class="product-details">
                <h3>Kitchen Utensils</h3>
                <p>Everyday kitchen tools and accessories</p>
                <a href="/inventory">View Inventory</a>
            </div>
        </article>

        <!-- Food Storage -->
        <article class="product-card">
            <div class="product-placeholder">
                <img src="/images/kitchen-products.webp"
                     alt="Kitchen products"
                     class="product-image" />
            </div>
            <div class="product-details">
                <h3>Food Storage</h3>
                <p>Containers and organization essentials</p>
                <a href="/inventory">View Inventory</a>
            </div>
        </article>

    </div>
</section>

</div>

