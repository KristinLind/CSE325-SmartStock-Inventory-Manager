@page "/"

<PageTitle>SmartStock | Dashboard</PageTitle>

<div class="smartstock-dashboard">

    <section class="smartstock-hero">
        <div class="hero-content">
            <span class="hero-eyebrow">WELCOME TO SMARTSTOCK</span>

            <h2>Everything for your kitchen, organized.</h2>

            <p>
                Track products, manage inventory, and keep your
                kitchen retail business running smoothly.
            </p>

            <span class="hero-tagline">
                Smart Inventory. Better Business.
            </span>
        </div>
    </section>


    <section class="dashboard-welcome">
        <div>
            <p class="dashboard-eyebrow">SMARTSTOCK INVENTORY MANAGER</p>
            <h1>Kitchen Inventory Dashboard</h1>
            <p>Organized inventory. Smarter business.</p>
        </div>
    </section>

    <section class="dashboard-stats">
        <div class="stat-card">
            <h2>Total Products</h2>
            <p class="stat-number">128</p>
            <div class="stat-accent navy-accent"></div>
        </div>

        <div class="stat-card">
            <h2>Low Stock Items</h2>
            <p class="stat-number tomato-text">8</p>
            <div class="stat-accent tomato-accent"></div>
        </div>

        <div class="stat-card">
            <h2>Inventory Value</h2>
            <p class="stat-number">$24,850</p>
            <div class="stat-accent saffron-accent"></div>
        </div>
    </section>

    

<section class="inventory-section">
    <div class="section-heading">
        <h2>Inventory Categories</h2>
        <span>Browse by Category</span>
    </div>

    <div class="product-grid">

        <!-- Cookware -->
        <article class="product-card">
            <div class="product-placeholder">
                <img src="/images/copper-pot.webp"
                     alt="Copper stock pot"
                     class="product-image" />
            </div>
            <div class="product-details">
                <h3>Cookware</h3>
                <p>Pots, pans, and cooking essentials</p>
                <a href="/inventory?category=Cookware">View Inventory</a>
            </div>
        </article>

        <!-- Appliances -->
        <article class="product-card">
            <div class="product-placeholder">
                <img src="/images/stand-mixer.webp"
                     alt="Stand mixer"
                     class="product-image" />
            </div>
            <div class="product-details">
                <h3>Appliances</h3>
                <p>Blenders, mixers, and kitchen appliances</p>
                <a href="/inventory?category=Appliances">View Inventory</a>
            </div>
        </article>

        <!-- Kitchen Utensils -->
        <article class="product-card">
            <div class="product-placeholder">
                <img src="/images/whisks.webp"
                     alt="two whisks"
                     class="product-image" />
            </div>
            <div class="product-details">
                <h3>Kitchen Utensils</h3>
                <p>Everyday kitchen tools and accessories</p>
                <a href="/inventory?category=Utensils">View Inventory</a>
            </div>
        </article>

        <!-- Food Storage -->
        <article class="product-card">
            <div class="product-placeholder">
                <img src="/images/kitchen-products.webp"
                     alt="Kitchen products"
                     class="product-image" />
            </div>
            <div class="product-details">
                <h3>Food Storage</h3>
                <p>Containers and organization essentials</p>
                <a href="/inventory?category=Food%20Storage">View Inventory</a>
            </div>
        </article>

    </div>
</section>

</div>

@*@page "/"
@inject ProductService Products
@inject SaleService SalesSvc

<PageTitle>SmartStock Dashboard</PageTitle>

<h1>SmartStock Dashboard</h1>

@if (summary is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-4">
            <div class="card text-center"><div class="card-body">
                <h6 class="text-muted">Products</h6><h3>@summary.TotalProducts</h3>
            </div></div>
        </div>
        <div class="col-6 col-md-4">
            <div class="card text-center"><div class="card-body">
                <h6 class="text-muted">Units in stock</h6><h3>@summary.TotalUnits</h3>
            </div></div>
        </div>
        <div class="col-6 col-md-4">
            <div class="card text-center"><div class="card-body">
                <h6 class="text-muted">Inventory value</h6><h3>@summary.InventoryValue.ToString("C")</h3>
            </div></div>
        </div>
        <div class="col-6 col-md-4">
            <div class="card text-center border-warning"><div class="card-body">
                <h6 class="text-muted">Low stock</h6><h3>@summary.LowStockCount</h3>
            </div></div>
        </div>
        <div class="col-6 col-md-4">
            <div class="card text-center border-danger"><div class="card-body">
                <h6 class="text-muted">Out of stock</h6><h3>@summary.OutOfStockCount</h3>
            </div></div>
        </div>
        <div class="col-6 col-md-4">
            <div class="card text-center"><div class="card-body">
                <h6 class="text-muted">Sales today</h6>
                <h3>@salesToday</h3>
                <small class="text-muted">@revenueToday.ToString("C") revenue</small>
            </div></div>
        </div>
    </div>

    <h4>Needs restocking</h4>
    @if (lowStock.Count == 0)
    {
        <p><em>Nothing is running low. 🎉</em></p>
    }
    else
    {
        <table class="table table-striped align-middle">
            <thead>
                <tr><th>Product</th><th>SKU</th><th>Category</th><th>Quantity</th><th>Reorder level</th><th>Status</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var p in lowStock)
                {
                    <tr>
                        <td>@p.Name</td>
                        <td>@p.Sku</td>
                        <td>@p.Category?.Name</td>
                        <td>@p.Quantity</td>
                        <td>@p.ReorderLevel</td>
                        <td><StockBadge Product="p" /></td>
                        <td class="text-end"><a class="btn btn-sm btn-outline-primary" href="products/edit/@p.Id">Restock</a></td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    private InventorySummary? summary;
    private List<Product> lowStock = new();
    private int salesToday;
    private decimal revenueToday;

    protected override async Task OnInitializedAsync()
    {
        summary = await Products.GetSummaryAsync();
        lowStock = await Products.GetLowStockAsync();
        (salesToday, revenueToday) = await SalesSvc.GetTodaySummaryAsync();
    }
}@**@

